{
  "seed": 42,
  "validation_fraction": 0.2,
  "split_method": "StratifiedGroupKFold(n_splits=5, shuffle=True), first fold held out",
  "tfidf": {
    "ngram_range": [
      1,
      2
    ],
    "min_df": 6,
    "max_df": 0.95,
    "max_features": 50000,
