    "lowercase": true,
    "strip_accents": null,
    "stop_words": null,
    "token_pattern": "(?u)\\b\\w[\\w\\-/+]*\\b",
    "dtype": "float32"
  },
  "structured_numeric_features": [
    "smiles_length_a",
    "text_chars_a",
    "text_fields_present_a",
    "smiles_length_b",
    "text_chars_b",
    "text_fields_present_b",
    "same_smiles",
    "missing_Indication_A",
    "missing_Indication_B",
    "missing_Warning_A",
    "missing_Warning_B",
    "missing_CYP450_Enzymes_A",
    "missing_CYP450_Enzymes_B"
  ],
  "fingerprints": {
    "created": true,
    "bits_per_drug": 2048,
    "unparsable_smiles": 0
  },
